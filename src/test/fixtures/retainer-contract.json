{
  "id": "retainer-contract",
  "label": "Retainer Contract",
  "shortLabel": "Retainer contract",
  "category": "Contracts",
  "description": "A recurring monthly engagement agreement for marketing or development work, billed as a flat fee and/or a target-based fee.",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "recipient": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "x-column": 1,
            "x-order": 1
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "title": "Email",
            "x-column": 1,
            "x-order": 2
          }
        },
        "required": ["name", "email"],
        "additionalProperties": false,
        "title": "Recipient",
        "x-section": "Recipient",
        "x-column": 1,
        "x-order": 1
      },
      "engagement": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "title": "Title",
            "x-column": 1,
            "x-order": 1
          },
          "quoteNumber": {
            "type": "string",
            "x-auto": true,
            "title": "Quote Number",
            "x-column": 1,
            "x-order": 2
          },
          "quoteDate": {
            "type": "string",
            "format": "date",
            "title": "Quote Date",
            "x-column": 1,
            "x-order": 3
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "title": "Start Date",
            "x-column": 1,
            "x-order": 4
          },
          "months": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "default": 6,
            "title": "Months",
            "x-column": 1,
            "x-order": 5
          },
          "renewalType": {
            "type": "string",
            "enum": ["Auto-Renew", "Manual Renewal", "No Renewal"],
            "default": "Manual Renewal",
            "title": "Renewal Type",
            "x-column": 1,
            "x-order": 6
          },
          "noticePeriodDays": {
            "default": 15,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "title": "Notice Period Days",
            "x-column": 1,
            "x-order": 7
          }
        },
        "required": [
          "title",
          "quoteNumber",
          "quoteDate",
          "startDate",
          "months",
          "renewalType",
          "noticePeriodDays"
        ],
        "additionalProperties": false,
        "title": "Engagement",
        "x-section": "Engagement",
        "x-column": 1,
        "x-order": 2
      },
      "serviceCategory": {
        "type": "string",
        "title": "Service Category",
        "x-column": 1,
        "x-order": 3
      },
      "scopeOfWork": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "title": "Scope Of Work",
        "x-column": 2,
        "x-order": 4
      },
      "compensation": {
        "type": "object",
        "properties": {
          "flatMonthlyFee": {
            "type": "number",
            "minimum": 0,
            "default": 20000,
            "title": "Flat Monthly Fee",
            "x-column": 1,
            "x-order": 1
          },
          "targetBasedFees": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string",
                  "title": "Description",
                  "x-column": 1,
                  "x-order": 1
                },
                "amountPerUnit": {
                  "type": "number",
                  "minimum": 0,
                  "title": "Amount Per Unit",
                  "x-column": 1,
                  "x-order": 2
                },
                "unit": {
                  "type": "string",
                  "title": "Unit",
                  "x-column": 1,
                  "x-order": 3
                }
              },
              "required": ["description", "amountPerUnit", "unit"],
              "additionalProperties": false
            },
            "title": "Target Based Fees",
            "x-column": 2,
            "x-order": 2
          },
          "onboardingFee": {
            "type": "number",
            "minimum": 0,
            "default": 0,
            "title": "Onboarding Fee",
            "x-column": 1,
            "x-order": 3
          },
          "currency": {
            "default": "INR",
            "type": "string",
            "title": "Currency",
            "x-column": 1,
            "x-order": 4
          }
        },
        "required": ["currency"],
        "additionalProperties": false,
        "title": "Compensation",
        "x-section": "Compensation",
        "x-column": 1,
        "x-order": 5
      },
      "agreementDate": {
        "type": "string",
        "format": "date",
        "title": "Agreement Date",
        "x-column": 1,
        "x-order": 6
      },
      "expiresIn": {
        "type": "string",
        "format": "date",
        "title": "Expires In",
        "x-column": 1,
        "x-order": 7
      },
      "terms": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "title": "Content",
            "x-column": 2,
            "x-order": 1
          },
          "lastUpdated": {
            "type": "string",
            "format": "date",
            "title": "Last Updated",
            "x-column": 1,
            "x-order": 2
          }
        },
        "required": ["content", "lastUpdated"],
        "additionalProperties": false,
        "title": "Terms",
        "x-section": "Terms",
        "x-column": 2,
        "x-order": 8
      }
    },
    "required": [
      "recipient",
      "engagement",
      "serviceCategory",
      "scopeOfWork",
      "compensation",
      "agreementDate",
      "expiresIn",
      "terms"
    ],
    "additionalProperties": false
  },
