{
  "id": "invoice",
  "label": "Billing Invoice",
  "shortLabel": "Invoice",
  "category": "Billing",
  "description": "The official document outlining the charges, payment terms, and amount due.",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "recipient": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "title": "Name", "x-column": 1, "x-order": 1 },
          "address": { "type": "string", "title": "Address", "x-column": 2, "x-order": 2 },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "title": "Email",
            "x-column": 1,
            "x-order": 3
          },
          "phone": { "type": "string", "title": "Phone", "x-column": 1, "x-order": 4 }
        },
        "required": ["name", "address", "email", "phone"],
        "additionalProperties": false,
        "title": "Recipient",
        "x-section": "Recipient",
        "x-column": 1,
        "x-order": 1
      },
      "pricingModel": {
        "type": "string",
        "enum": ["project", "day"],
        "default": "project",
        "title": "Pricing Model",
        "x-column": 1,
        "x-order": 2
      },
      "project": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "title": "Title", "x-column": 1, "x-order": 1 },
          "quoteNumber": {
            "type": "string",
            "x-auto": true,
            "title": "Quote Number",
            "x-column": 1,
            "x-order": 2
          },
          "quoteDate": {
            "type": "string",
            "format": "date",
            "title": "Quote Date",
            "x-column": 1,
            "x-order": 3
          },
          "invoiceNumber": {
            "type": "string",
            "x-auto": true,
            "title": "Invoice Number",
            "x-column": 1,
            "x-order": 4
          },
          "invoiceDate": {
            "type": "string",
            "format": "date",
            "title": "Invoice Date",
            "x-column": 1,
            "x-order": 5
          },
          "shootDate": {
            "type": "string",
            "format": "date",
            "title": "Shoot Date",
            "x-column": 1,
            "x-order": 6
          },
          "shootLocation": {
            "type": "string",
            "title": "Shoot Location",
            "x-column": 1,
            "x-order": 7
          },
          "deliverables": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string", "title": "Title", "x-column": 1, "x-order": 1 },
                "description": {
                  "type": "string",
                  "title": "Description",
                  "x-column": 1,
                  "x-order": 2
                },
                "points": {
                  "type": "array",
                  "items": { "type": "string" },
                  "title": "Points",
                  "x-column": 2,
                  "x-order": 3
                },
                "quantity": {
                  "type": "number",
                  "minimum": 0,
                  "title": "Quantity",
                  "x-column": 1,
                  "x-order": 4
                },
                "rate": {
                  "type": "number",
                  "minimum": 0,
                  "title": "Rate",
                  "x-column": 1,
                  "x-order": 5
                }
              },
              "additionalProperties": false
            },
            "title": "Deliverables",
            "x-column": 2,
            "x-order": 8
          }
        },
        "required": [
          "title",
          "quoteNumber",
          "quoteDate",
          "invoiceNumber",
          "invoiceDate",
          "shootDate",
          "shootLocation",
          "deliverables"
        ],
        "additionalProperties": false,
        "title": "Project",
        "x-section": "Project",
        "x-column": 1,
        "x-order": 3
      },
      "financials": {
        "type": "object",
        "properties": {
          "discountLabel": {
            "type": "string",
            "default": "Discount",
            "title": "Discount Label",
            "x-column": 1,
            "x-order": 1
          },
          "discountValue": {
            "type": "number",
            "minimum": 0,
            "default": 0,
            "title": "Discount Value",
            "x-column": 1,
            "x-order": 2
          },
          "isDiscountPercentage": {
            "type": "boolean",
            "default": false,
            "title": "Is Discount Percentage",
            "x-column": 1,
            "x-order": 3
          },
          "taxLabel": {
            "type": "string",
            "default": "IGST @ 18%",
            "title": "Tax Label",
            "x-column": 1,
            "x-order": 4
          },
          "taxRate": {
            "type": "number",
            "minimum": 0,
            "default": 18,
            "title": "Tax Rate",
            "x-column": 1,
            "x-order": 5
          },
          "amountPaid": {
            "type": "number",
            "minimum": 0,
            "default": 13500,
            "title": "Amount Paid",
            "x-column": 1,
            "x-order": 6
          }
        },
        "additionalProperties": false,
        "title": "Financials",
        "x-section": "Financials",
        "x-column": 1,
        "x-order": 4
      },
      "dueDate": {
        "type": "string",
        "format": "date",
        "title": "Due Date",
        "x-column": 1,
        "x-order": 5
      }
    },
    "required": ["recipient", "project", "dueDate"],
    "additionalProperties": false
  },
