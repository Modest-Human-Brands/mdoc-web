{
  "id": "internship-completion-certificate",
  "label": "Internship Completion Certificate",
  "shortLabel": "Internship certificate",
  "category": "Certificates",
  "description": "The formal proof of completion, including your start and end dates, role, and an authorized signature.",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "recipient": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "title": "Name", "x-column": 1, "x-order": 1 },
          "role": { "type": "string", "title": "Role", "x-column": 1, "x-order": 2 },
          "address": { "type": "string", "title": "Address", "x-column": 2, "x-order": 3 },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "title": "Email",
            "x-column": 1,
            "x-order": 4
          },
          "phone": { "type": "string", "title": "Phone", "x-column": 1, "x-order": 5 }
        },
        "required": ["name", "role", "address", "email", "phone"],
        "additionalProperties": false,
        "title": "Recipient",
        "x-section": "Recipient",
        "x-column": 1,
        "x-order": 1
      },
      "scopeOfWork": { "type": "string", "title": "Scope Of Work", "x-column": 1, "x-order": 2 },
      "startDate": {
        "type": "string",
        "format": "date",
        "title": "Start Date",
        "x-column": 1,
        "x-order": 3
      },
      "endDate": {
        "type": "string",
        "format": "date",
        "title": "End Date",
        "x-column": 1,
        "x-order": 4
      }
    },
    "required": ["recipient", "scopeOfWork", "startDate", "endDate"],
    "additionalProperties": false
  },
  "variables": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "recipient": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "title": "Name", "x-column": 1, "x-order": 1 },
          "role": { "type": "string", "title": "Role", "x-column": 1, "x-order": 2 },
          "address": { "type": "string", "title": "Address", "x-column": 2, "x-order": 3 },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "title": "Email",
            "x-column": 1,
            "x-order": 4
          },
          "phone": { "type": "string", "title": "Phone", "x-column": 1, "x-order": 5 }
        },
        "required": ["name", "role", "address", "email", "phone"],
        "additionalProperties": false,
        "title": "Recipient",
        "x-section": "Recipient",
        "x-column": 1,
        "x-order": 1
      },
      "scopeOfWork": { "type": "string", "title": "Scope Of Work", "x-column": 1, "x-order": 2 },
      "startDate": {
        "type": "string",
        "format": "date",
        "title": "Start Date",
        "x-column": 1,
        "x-order": 3
      },
      "endDate": {
        "type": "string",
        "format": "date",
        "title": "End Date",
        "x-column": 1,
        "x-order": 4
      }
    },
    "required": ["recipient", "scopeOfWork", "startDate", "endDate"],
