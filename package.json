{
  "name": "mdoc-web",
  "version": "0.0.2",
  "private": true,
  "description": "Web UI of MDoc",
  "license": "MIT",
  "author": "Shirsendu Bairagi <shirsendu2001@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Modest-Human-Brands/mdoc-web.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "vp dev",
    "detect": "gitleaks git --verbose",
    "lint": "vp lint . --fix",
    "format": "vp fmt src/",
    "test:unit": "vp test",
    "build": "vp build",
    "preview": "vp preview",
    "docker:build": "docker build --build-arg VERSION=dev --build-arg BUILD_TIME=now -t mdoc-web:dev .",
    "docker:start": "docker run --detach --name mdoc-web-dev --env-file .env -p 2000:8080 mdoc-web:dev"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.33.0",
    "@tato30/vue-pdf": "^2.2.0",
    "@vueuse/core": "^15.0.0",
    "notform": "^3.0.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@fontsource-variable/exo-2": "^5.3.0",
    "@iconify-json/lucide": "^1.2.140",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "unplugin-fonts": "^2.0.0",
    "unplugin-icons": "^24.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plus": "1.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
  },
  "engines": {
    "bun": "^1.2.9",
    "node": "^22.11.0 || ^24.14.0",
    "pnpm": "^9.15.0 || ^10.2.0 || ^11.0.0"
  },
  "packageManager": "bun@1.4.2"
}