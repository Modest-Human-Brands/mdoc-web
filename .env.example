# Base URL of the MDoc API. Leave empty to use the same-origin /api path
# (Vite dev proxy in development, nginx proxy in production).
VITE_API_BASE_URL=

# Dev-only: where the Vite dev server proxies /api to.
VITE_API_PROXY_TARGET=http://localhost:3002

# Default organisation preset (server-side branding). Users can change it in the Brand step.
VITE_DEFAULT_ORGANIZATION_ID=modest-human-brands
