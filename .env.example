# Base URL of the MDoc API. Leave empty to use the same-origin /api path
# (Vite dev proxy in development, nginx proxy in production).
VITE_API_BASE_URL=

# Dev-only: where the Vite dev server proxies /api to.
VITE_API_PROXY_TARGET=http://localhost:3002

# Default organisation preset (server-side branding). Users can change it in the Brand step.
VITE_DEFAULT_ORGANIZATION_ID=modest-human-brands

# Notion ids the API requires when saving a document. Not shown in the UI for now.
# Development: put the real values in .env.local (git-ignored), never in this file.
VITE_USER_ID=
VITE_CONTACT_ID=
VITE_PROJECT_ID=

# Docker: the image never contains these. Pass them when the container starts, e.g.
#   docker run --env-file .env.prod -p 2000:8080 mdoc-web:dev      (.env.prod is git-ignored)
# using these names instead (read by docker/runtime-config.sh):
#   MDOC_USER_ID=
#   MDOC_CONTACT_ID=
#   MDOC_PROJECT_ID=
#   MDOC_ORGANIZATION_ID=
#   MDOC_API_BASE_URL=
